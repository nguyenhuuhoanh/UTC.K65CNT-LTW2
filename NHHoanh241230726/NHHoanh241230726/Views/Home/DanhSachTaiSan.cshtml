@model IEnumerable<NHHoanh241230726.Models.TaiSan>
<div class="grid">
    @foreach (var t in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@t.Anh" alt="@t.TenTs" /></a>
            <h2>@t.TenTs</h2>
            <div class="asset-foot">
                <span class="price">@(t.NguyenGia.HasValue ? t.NguyenGia.Value.ToString("0") : "0") tr</span>
                <a class="btn-buy" style="text-decoration:none"
                   asp-action="Edit" asp-route-id="@t.MaTs">Sửa</a>
            </div>
        </div>
    }
</div>
