@model IEnumerable<NHHoanh241230726.Models.TaiSan>
@{
    ViewData["Title"] = "Trang chủ";
}
<div class="section-head">
    <h3 id="tieu-de">Nguyen Huu Hoanh</h3>
</div>
<div id="ds-tai-san">
    <partial name="DanhSachTaiSan" model="Model" />
</div>

@section Scripts {
    <script>
        $(document).on('click', '.loai-link', function (e) {
            e.preventDefault();
            var id = $(this).data('id');
            var ten = $(this).data('ten');
            $('#tieu-de').text(ten);
            $('.menu li').removeClass('active');
            $(this).parent().addClass('active');
            $('#ds-tai-san').load('@Url.Action("TheoLoai", "Home")' + '?id=' + id);
        });
    </script>
}
