@model List<Product>
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="row">
    <div class="col-md-3">
        <partial name="_CategoryMenu" />
    </div>
    <div class="col-md-9">
        <div class="bg-primary text-white p-2 mb-3">Tất cả sản phẩm</div>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card mb-3">
                        <img src="@item.Image" class="card-img-top" alt="@item.Name" onerror="this.src='https://via.placeholder.com/300x200?text=Product'">
                        <div class="card-body">
                            <h6 class="card-title">@item.Name</h6>
                            <p class="card-text text-danger">@item.Price.ToString("N0") đ</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
